\newlabel{fig: rule0}{{7.1a}{80}{Addition to a cyanide: in this rule \texttt {x} $\in $ \{N, O\}, representing the addition of an amide nitrogen or hydroxyl oxygen to the nitrile bond respectively}{figure.caption.102}{}}
\newlabel{sub@fig: rule0}{{a}{80}{Addition to a cyanide: in this rule \texttt {x} $\in $ \{N, O\}, representing the addition of an amide nitrogen or hydroxyl oxygen to the nitrile bond respectively}{figure.caption.102}{}}
\newlabel{fig: rule1}{{7.1b}{80}{Addition to an imine or carbonyl: in this rule \texttt {x}, \texttt {y} $\in $ \{N, O\}, representing the addition of an amide nitrogen or hydroxyl oxygen to an amide or hydroxyl bond respectively. This single rule encapsulates $2^2 = 4$ individual rules depending on the instantiation of \texttt {x} and \texttt {y}}{figure.caption.102}{}}
\newlabel{sub@fig: rule1}{{b}{80}{Addition to an imine or carbonyl: in this rule \texttt {x}, \texttt {y} $\in $ \{N, O\}, representing the addition of an amide nitrogen or hydroxyl oxygen to an amide or hydroxyl bond respectively. This single rule encapsulates $2^2 = 4$ individual rules depending on the instantiation of \texttt {x} and \texttt {y}}{figure.caption.102}{}}
\newlabel{fig: rule2}{{7.1c}{80}{1,3 hydrogen shift: in this rule \texttt {x}, \texttt {y} $\in $ \{C, N, O\}, representing the shift of a double bond as in tautomerism. When \texttt {x}$\equiv $O and \texttt {y}$\equiv $O it is keto-enol tautomerism, \texttt {x}$\equiv $N and \texttt {y}$\equiv $N is imine-enamine tautomerism, \texttt {x}$\equiv $N and \texttt {y}$\equiv $O is amine-iminol tautomerism and \texttt {x}$\equiv $C and \texttt {y}$\equiv $C is an allylic shift of the double bond. This single rule encapsulates $3\times 3 = 9$ individual rules depending on the instantiation of \texttt {x} and \texttt {y}}{figure.caption.102}{}}
\newlabel{sub@fig: rule2}{{c}{80}{1,3 hydrogen shift: in this rule \texttt {x}, \texttt {y} $\in $ \{C, N, O\}, representing the shift of a double bond as in tautomerism. When \texttt {x}$\equiv $O and \texttt {y}$\equiv $O it is keto-enol tautomerism, \texttt {x}$\equiv $N and \texttt {y}$\equiv $N is imine-enamine tautomerism, \texttt {x}$\equiv $N and \texttt {y}$\equiv $O is amine-iminol tautomerism and \texttt {x}$\equiv $C and \texttt {y}$\equiv $C is an allylic shift of the double bond. This single rule encapsulates $3\times 3 = 9$ individual rules depending on the instantiation of \texttt {x} and \texttt {y}}{figure.caption.102}{}}
