\newlabel{fig: heatEngine}{{4.1a}{36}{A heat engine attempts to maximize the work done $W = Q_H - Q_C$, while transferring energy in the form of heat between two reservoirs at temperatures $T_0$ and $T_1$, respectively}{figure.caption.21}{}}
\newlabel{sub@fig: heatEngine}{{a}{36}{A heat engine attempts to maximize the work done $W = Q_H - Q_C$, while transferring energy in the form of heat between two reservoirs at temperatures $T_0$ and $T_1$, respectively}{figure.caption.21}{}}
\newlabel{fig: heatPathway}{{4.1b}{36}{The pathway followed by the heat engine while performing work $W$ is illustrated in the physical $P-V$ space of the system}{figure.caption.21}{}}
\newlabel{sub@fig: heatPathway}{{b}{36}{The pathway followed by the heat engine while performing work $W$ is illustrated in the physical $P-V$ space of the system}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Thermodynamics studied the pathways traversed by heat engines in the $P-V$ space which maximized the work done by it. The efficiency of such heat engines was calculated as $\eta = \frac  {W}{Q_H} = \frac  {Q_H - Q_C}{Q_H} = 1 - \frac  {Q_C}{Q_H}$ which can be shown t be equivalent to $\eta = 1 - \frac  {T_1}{T_0}$. therefore, increasing the temperature gradient in the system increased the work done by the heat engine under ideal conditions.}}{36}{figure.caption.21}\protected@file@percent }
\newlabel{fig: heatCycles}{{4.1}{36}{Thermodynamics studied the pathways traversed by heat engines in the $P-V$ space which maximized the work done by it. The efficiency of such heat engines was calculated as $\eta = \frac {W}{Q_H} = \frac {Q_H - Q_C}{Q_H} = 1 - \frac {Q_C}{Q_H}$ which can be shown t be equivalent to $\eta = 1 - \frac {T_1}{T_0}$. therefore, increasing the temperature gradient in the system increased the work done by the heat engine under ideal conditions}{figure.caption.21}{}}
