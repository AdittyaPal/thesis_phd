\BKM@entry{id=17,dest={73656374696F6E2E342E31},srcline={49}}{5C3337365C3337375C3030304D5C303030615C303030745C303030685C303030655C3030306D5C303030615C303030745C303030695C303030635C303030615C3030306C5C3030305C3034305C303030465C3030306F5C303030725C3030306D5C303030755C3030306C5C303030615C303030745C303030695C3030306F5C3030306E}
\newlabel{fig: heatEngine}{{16a}{40}{A heat engine attempts to maximize the work done $W = Q_H - Q_C$, while transferring energy in the form of heat between two reservoirs at temperatures $T_0$ and $T_1$, respectively}{figure.caption.17}{}}
\newlabel{sub@fig: heatEngine}{{a}{40}{A heat engine attempts to maximize the work done $W = Q_H - Q_C$, while transferring energy in the form of heat between two reservoirs at temperatures $T_0$ and $T_1$, respectively}{figure.caption.17}{}}
\newlabel{fig: heatPathway}{{16b}{40}{The pathway followed by the heat engine while performing work $W$ is illustrated in the physical $P-V$ space of the system}{figure.caption.17}{}}
\newlabel{sub@fig: heatPathway}{{b}{40}{The pathway followed by the heat engine while performing work $W$ is illustrated in the physical $P-V$ space of the system}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Thermodynamics studied the pathways traversed by heat engines in the $P-V$ space which maximized the work done by it. The efficiency of such heat engines was calculated as $\eta = \frac  {W}{Q_H} = \frac  {Q_H - Q_C}{Q_H} = 1 - \frac  {Q_C}{Q_H}$ which can be shown t be equivalent to $\eta = 1 - \frac  {T_1}{T_0}$. therefore, increasing the temperature gradient in the system increased the work done by the heat engine under ideal conditions.}}{40}{figure.caption.17}\protected@file@percent }
\newlabel{fig: heatCycles}{{16}{40}{Thermodynamics studied the pathways traversed by heat engines in the $P-V$ space which maximized the work done by it. The efficiency of such heat engines was calculated as $\eta = \frac {W}{Q_H} = \frac {Q_H - Q_C}{Q_H} = 1 - \frac {Q_C}{Q_H}$ which can be shown t be equivalent to $\eta = 1 - \frac {T_1}{T_0}$. therefore, increasing the temperature gradient in the system increased the work done by the heat engine under ideal conditions}{figure.caption.17}{}}
