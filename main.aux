\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces Comparison of the relative distribution of the four reaction templates among the successful applications of a reaction template~$r$ on a molecular pair $(m_1,m_2)$. Successful means that the left-hand side of $r$ has one or more matches as a subgraph of $m_1 \cup m_2$. The blue bars show this for the contents of a cache of size~$2^8$ at the end of the simulation, the cyan bars show the same for a cache of size~$2^{15}$, and the navy bars show the distribution across all steps of the entire simulation. The error bars represent the standard deviation in the frequency over the $10$ trials conducted.}}{109}{figure.caption.124}\protected@file@percent }
\newlabel{fig:frequencyTemplate}{{9.5}{109}{Comparison of the relative distribution of the four reaction templates among the successful applications of a reaction template~$r$ on a molecular pair $(m_1,m_2)$. Successful means that the left-hand side of $r$ has one or more matches as a subgraph of $m_1 \cup m_2$. The blue bars show this for the contents of a cache of size~$2^8$ at the end of the simulation, the cyan bars show the same for a cache of size~$2^{15}$, and the navy bars show the distribution across all steps of the entire simulation. The error bars represent the standard deviation in the frequency over the $10$ trials conducted}{figure.caption.124}{}}
