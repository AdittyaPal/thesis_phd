\newlabel{fig: case1}{{6.1a}{66}{the thermodynamically more favored reaction are generally also kinetically preferred}{figure.caption.72}{}}
\newlabel{sub@fig: case1}{{a}{66}{the thermodynamically more favored reaction are generally also kinetically preferred}{figure.caption.72}{}}
\newlabel{fig: case2}{{6.1b}{66}{the thermodynamically less favored reaction with a smaller negative Gibbs free energy difference is also kinetically preferred because it has a lower energy barrier}{figure.caption.72}{}}
\newlabel{sub@fig: case2}{{b}{66}{the thermodynamically less favored reaction with a smaller negative Gibbs free energy difference is also kinetically preferred because it has a lower energy barrier}{figure.caption.72}{}}
\newlabel{fig: case3}{{6.1c}{66}{the thermodynamically unfavored reactions (with a positive Gibbs free energy difference) generally have higher energy barriers and are kinetically not preferred}{figure.caption.72}{}}
\newlabel{sub@fig: case3}{{c}{66}{the thermodynamically unfavored reactions (with a positive Gibbs free energy difference) generally have higher energy barriers and are kinetically not preferred}{figure.caption.72}{}}
