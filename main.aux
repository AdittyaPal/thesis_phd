\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces An integer hyperflow query in the directed hypergraph from Figure~{ref: hypergraph}, where $v_0$ is specified as the source and $v_7$ is specified as the target. The exact inflow and outflow on these vertices are not specified, and the hyperpaths in Figure~\ref {fig: hyperpath1}, \ref {fig: hyperpath2}, \ref {fig: hyperpath3}, \ref {fig: hyperpath4} and \ref {fig: hyperpath5} would be valid solutions of this flow query if the required additional sets of vertices is allowed as sources (which are {\O }, $\{v_2\}$, $\{v_1\}$, $\{v_2\}$, $\{v_6\}$ respectively). If additional vertices are not allowed as sources, only the hyperpath in Figure~\ref {fig: hyperpath1} is a valid solution.}}{20}{figure.caption.5}\protected@file@percent }
\newlabel{fig: flow_query}{{4}{20}{An integer hyperflow query in the directed hypergraph from Figure~{ref: hypergraph}, where $v_0$ is specified as the source and $v_7$ is specified as the target. The exact inflow and outflow on these vertices are not specified, and the hyperpaths in Figure~\ref {fig: hyperpath1}, \ref {fig: hyperpath2}, \ref {fig: hyperpath3}, \ref {fig: hyperpath4} and \ref {fig: hyperpath5} would be valid solutions of this flow query if the required additional sets of vertices is allowed as sources (which are {\O }, $\{v_2\}$, $\{v_1\}$, $\{v_2\}$, $\{v_6\}$ respectively). If additional vertices are not allowed as sources, only the hyperpath in Figure~\ref {fig: hyperpath1} is a valid solution}{figure.caption.5}{}}
